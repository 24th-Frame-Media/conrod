# Release assembly (CI builds the portable folder and checksums here)
dist/

# Model weights and caches live outside the repo, but never commit strays
*.pt
*.onnx

# Local scratch
samples/*.local.csv
.DS_Store
Thumbs.db

# The Python app's leftovers on a machine that used it (its code is on the legacy-python branch)
.venv/
__pycache__/
build/

# Rust and frontend build output. Keep it out of OneDrive: set CARGO_TARGET_DIR to a local folder.
target/
frontend/node_modules/
frontend/dist/
crates/conrod-app/gen/
# Fixtures that point at the photographer's own frames; never committed.
fixtures/*_local.json

# Release assets are fetched, not committed (see scripts/README.md)
crates/conrod-app/resources/models/
crates/conrod-app/resources/exiftool/
