# Release assembly (CI builds the portable folder and checksums here)
dist/

# Model weights and caches live outside the repo, but never commit strays
*.pt
*.onnx

# Local scratch
samples/*.local.csv
.DS_Store
Thumbs.db

# The Python app's leftovers on a machine that used it (its code is on the legacy-python branch)
.venv/
__pycache__/
build/

# Rust build output. Keep it out of OneDrive: set CARGO_TARGET_DIR to a local folder.
rust/target/
rust/frontend/node_modules/
rust/frontend/dist/
rust/crates/conrod-app/gen/
# Fixtures that point at the photographer's own frames; never committed.
rust/fixtures/*_local.json

# Release assets are fetched, not committed (see rust/scripts/README.md)
rust/crates/conrod-app/resources/models/
rust/crates/conrod-app/resources/exiftool/
rust/dist/
