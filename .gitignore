__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Builds
build/
dist/
*.spec.bak

# Model weights and caches live outside the repo, but never commit strays
*.pt
*.onnx

# Local scratch
samples/*.local.csv
.DS_Store
Thumbs.db

# Generated by assets/make_icon.py for eyeballing the result.
assets/icon-preview.png

# Rust build output. Keep it out of OneDrive: set CARGO_TARGET_DIR to a local folder.
rust/target/
