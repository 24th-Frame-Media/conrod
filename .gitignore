rust/frontend/dist/
rust/crates/conrod-app/gen/
# Fixtures that point at the photographer's own frames; never committed.
rust/fixtures/*_local.json

# Release assets are fetched, not committed (see rust/scripts/README.md)
rust/crates/conrod-app/resources/models/
rust/crates/conrod-app/resources/exiftool/
rust/dist/
