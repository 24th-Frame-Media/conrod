{
  "name": "conrod-desktop",
  "version": "1.0.0-beta.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "tauri": "cd ../crates/conrod-app && node ../../frontend/node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "cd ../crates/conrod-app && node ../../frontend/node_modules/@tauri-apps/cli/tauri.js dev -c tauri.dev.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
