{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conrod",
  "identifier": "com.kapsikkum.conrod",
  "build": {
    "frontendDist": "../../frontend/dist",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Conrod",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "backgroundColor": "#0b0b0d",
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/kapsikkum/conrod/releases/download/updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRTE4NDhFRkNFQkM3MTgKUldRWXgrdjhqb1RoVDc1QmRmeG9aMjBxNHVqbDd1UFZ4eHNCcW1CQ2N2ZkRUUGpteWxOanpHVnEK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/conrod.ico"
    ],
    "shortDescription": "Cull, review and keyword your photographs",
    "category": "Photography",
    "publisher": "kapsikkum",
    "copyright": "Copyright (C) kapsikkum. AGPL-3.0-only.",
    "resources": {
      "resources/**/*": "resources/",
      "../../lightroom-plugin/ConrodBridge.lrplugin/**/*": "lightroom-plugin/ConrodBridge.lrplugin/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "licenseFile": "../../LICENSE"
  }
}
