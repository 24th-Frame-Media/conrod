{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conrod",
  "version": "1.0.0-beta.4",
  "identifier": "com.kapsikkum.conrod",
  "build": {
    "frontendDist": "../../frontend/dist",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Conrod",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "backgroundColor": "#0b0b0d",
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/conrod.ico"
    ],
    "shortDescription": "Cull, review and keyword your photographs",
    "category": "Photography",
    "publisher": "kapsikkum",
    "copyright": "Copyright (C) kapsikkum. AGPL-3.0-only.",
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "licenseFile": "../../LICENSE"
  }
}
